{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=logiflow;Username=logiflow"
  },
  "Jwt": {
    "Issuer": "LogiFlow.Api",
    "Audience": "LogiFlow.Client",
