    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "AuthCookies": {
    "RefreshTokenSecure": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
