# [ALL] agent-service environment variable NAMES (no secrets committed).
# Copy to .env locally; .env is git-ignored.

# LLM — Ollama, local, free (satisfies the no-paid-service rule).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Backend the agents reach for allow-listed tool endpoints.
BACKEND_API_BASE_URL=http://localhost:5080

# Shared secret so ONLY the backend may call this internal service.
# Leave blank in local dev to disable the guard.
AGENT_SERVICE_API_KEY=
