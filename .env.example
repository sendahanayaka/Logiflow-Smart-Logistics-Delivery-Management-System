# Backend configuration (set these in your shell or IDE; .NET does not load
# this file automatically).
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=logiflow;Username=logiflow;Password=replace-with-local-password"
Jwt__Issuer="LogiFlow.Api"
Jwt__Audience="LogiFlow.Client"
Jwt__SigningKey="replace-with-a-random-secret-at-least-32-bytes"
Jwt__ExpiryMinutes="60"
Jwt__RefreshTokenExpiryDays="7"
Cors__AllowedOrigins__0="http://localhost:5173"
AuthCookies__RefreshTokenSecure="false"

# Optional Development-only bootstrap account. The password must satisfy the
# documented password policy. Public registration always creates Customers.
IdentitySeed__OperationsManager__Email="manager@example.com"
IdentitySeed__OperationsManager__Password="replace-with-a-strong-development-password"
IdentitySeed__OperationsManager__FullName="Development Operations Manager"
IdentitySeed__OperationsManager__PhoneNumber="+00000000000"
